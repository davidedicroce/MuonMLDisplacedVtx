universe = vanilla

executable = scripts/tune.sh

log    = scripts/condor_logs/tune.$(Cluster).log
output = scripts/condor_logs/tune.$(Cluster).$(Process).out
error  = scripts/condor_logs/tune.$(Cluster).$(Process).err

getenv = True
transfer_input_files = tune_DisplacedVertex_optuna.py, train_DisplacedVertex.py, dv_training_utils.py, dv_converter_utils.py

# Smoke-test defaults: keep the GPU request tiny so Condor has the best chance
# to match the job. Override these values at submit time for larger studies.
environment = "REPO_DIR=$(SUBMIT_DIR) CLUSTER=$(Cluster) PROCESS=$(Process) N_TRIALS=3 FAST_EPOCHS=2 FAST_MAX_TRAIN_EVENTS=1000 REFIT_TOP_K=0 NUM_WORKERS=1 FAST_GPUS_PER_TRIAL=1 N_JOBS=1 HEARTBEAT_INTERVAL=120"

# Single-GPU smoke test. Keep CPUs/RAM aligned with NUM_WORKERS=1.
request_GPUs = 1
request_cpus = 2
request_memory = 8 GB
request_disk = 5 GB

+JobFlavour = "workday"

queue 1
